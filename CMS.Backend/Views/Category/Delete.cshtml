@using CMS.Data.Entities

@{
    ViewData["Title"] = "Xóa danh mục";
}

<!-- Page Header -->
<div class="mb-4">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<!-- Delete Confirmation -->
<div style="max-width: 600px;">
    <div class="alert alert-danger border-start border-5" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 1.5rem; margin-right: 1rem;"></i>
            <div>
                <h4 class="alert-heading mb-1">Xác nhận xóa</h4>
                <p class="mb-0">Bạn chắc chắn muốn xóa danh mục này không? Hành động này không thể hoàn tác.</p>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="mb-3">
                <h6 class="text-muted">Tên danh mục:</h6>
                <p class="h5 mb-0">@Model?.Name</p>
            </div>

            <div class="mb-3">
                <h6 class="text-muted">Mô tả:</h6>
                <p class="mb-0">@Model?.Description</p>
            </div>

            <div class="pt-3 border-top">
                <form asp-action="Delete" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@Model?.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
