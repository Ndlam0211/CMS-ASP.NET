@using CMS.Data.Entities

@{
    ViewData["Title"] = "Chi tiết danh mục";
}

<!-- Page Header -->
<div class="mb-4">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<!-- Details Container -->
<div style="max-width: 800px;">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0">@Model?.Name</h5>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <h6 class="text-muted">Mô tả:</h6>
                <p>@Model?.Description</p>
            </div>

            @if (Model?.Posts != null && Model.Posts.Count > 0)
            {
                <div class="mt-4">
                    <h6 class="mb-3">Bài viết trong danh mục (@Model.Posts.Count)</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Tiêu đề</th>
                                    <th>Ngày đăng</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var post in Model.Posts)
                                {
                                    <tr>
                                        <td><strong>@post.Title</strong></td>
                                        <td><small class="text-muted">@post.CreatedDate.ToString("dd/MM/yyyy")</small></td>
                                        <td>
                                            <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="d-flex gap-2 pt-3 border-top">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Xóa
                </a>
            </div>
        </div>
    </div>
</div>
