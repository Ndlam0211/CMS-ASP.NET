@model IEnumerable<CMS.Data.Entities.Category>

@{
	ViewData["Title"] = "Quản lý danh mục";
}

<div class="container my-5">
	<div class="row mb-4">
		<div class="col-12">
			<div class="d-flex justify-content-between align-items-center">
				<h1 class="display-4">Quản lý danh mục</h1>
				<a asp-action="Create" class="btn btn-primary btn-lg">
					<i class="bi bi-plus-circle"></i> Thêm danh mục
				</a>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			@if (Model != null && Model.Count() > 0)
			{
				<div class="table-responsive">
					<table class="table table-hover table-striped">
						<thead class="table-dark">
							<tr>
								<th>#</th>
								<th>Tên danh mục</th>
								<th>Mô tả</th>
								<th>Hành động</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var category in Model)
							{
								<tr>
									<td>@category.Id</td>
									<td>
										<strong>@category.Name</strong>
									</td>
									<td>@category.Description</td>
									<td>
										<a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-info">
											<i class="bi bi-eye"></i> Xem
										</a>
										<a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning">
											<i class="bi bi-pencil-square"></i> Sửa
										</a>
										<a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-danger">
											<i class="bi bi-trash"></i> Xóa
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="alert alert-info" role="alert">
					<h4 class="alert-heading">Không có danh mục</h4>
					<p>Hiện tại chưa có danh mục nào trong hệ thống.</p>
				</div>
			}
		</div>
	</div>
</div>