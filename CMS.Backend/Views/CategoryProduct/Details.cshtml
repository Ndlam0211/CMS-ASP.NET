@using CMS.Data.Entities

@{
    ViewData["Title"] = "Chi tiết danh mục sản phẩm";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title display-6">@Model?.Name</h1>

                    <div class="border-bottom pb-3 mb-4">
                        <p class="card-text">@Model?.Description</p>
                    </div>

                    @if (Model?.Products != null && Model.Products.Count > 0)
                    {
                        <h5 class="mt-4 mb-3">Sản phẩm trong danh mục</h5>
                        <div class="row g-3">
                            @foreach (var product in Model.Products)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 150px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="card-img-top bg-secondary" style="height: 150px;"></div>
                                        }
                                        <div class="card-body">
                                            <h6 class="card-title">@product.Name</h6>
                                            <p class="card-text text-muted small">@product.Price.ToString("N0") VND</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Danh mục này chưa có sản phẩm nào.</p>
                    }

                    <div class="d-flex gap-2 border-top pt-4 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
