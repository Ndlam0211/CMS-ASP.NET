@using CMS.Data.Entities

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title display-6">@Model?.FullName</h1>

                    <div class="border-bottom pb-3 mb-4">
                        <p class="mb-2">
                            <strong>Email:</strong> <a href="mailto:@Model?.Email">@Model?.Email</a>
                        </p>
                        <p class="mb-2">
                            <strong>Điện thoại:</strong> <a href="tel:@Model?.Phone">@Model?.Phone</a>
                        </p>
                        <p class="mb-0">
                            <strong>Địa chỉ:</strong> @Model?.Address
                        </p>
                    </div>

                    @if (Model?.Orders != null && Model.Orders.Count > 0)
                    {
                        <h5 class="mt-4 mb-3">Đơn hàng của khách hàng</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Trạng thái</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td>#@order.Id</td>
                                            <td>
                                                @if (order.Status == 0)
                                                    {
                                                        <span class="badge bg-warning">Chờ duyệt</span>
                                                    }
                                                    else if (order.Status == 1)
                                                    {
                                                        <span class="badge bg-info">Đang giao</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">Hoàn thành</span>
                                                    }
                                            </td>
                                            <td>@order.Notes</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex gap-2 border-top pt-4 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
