@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Bảng Điều Khiển";
}

<!-- Dashboard Header -->
<div class="mb-4">
    <h1 class="h3 mb-1">
        <i class="bi bi-speedometer2"></i> Bảng Điều Khiển
    </h1>
    <p class="text-muted mb-0">Chào mừng quay trở lại, Nguyen Dinh Lam</p>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-5">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-left: 4px solid #4f46e5;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Tổng Bài Viết</p>
                        <h4 class="mb-0">24</h4>
                    </div>
                    <div style="font-size: 2.5rem; color: #4f46e5; opacity: 0.2;">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-left: 4px solid #10b981;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Danh Mục</p>
                        <h4 class="mb-0">8</h4>
                    </div>
                    <div style="font-size: 2.5rem; color: #10b981; opacity: 0.2;">
                        <i class="bi bi-grid-3x2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-left: 4px solid #f59e0b;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Người Dùng</p>
                        <h4 class="mb-0">12</h4>
                    </div>
                    <div style="font-size: 2.5rem; color: #f59e0b; opacity: 0.2;">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm" style="border-left: 4px solid #ef4444;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Đơn Hàng</p>
                        <h4 class="mb-0">156</h4>
                    </div>
                    <div style="font-size: 2.5rem; color: #ef4444; opacity: 0.2;">
                        <i class="bi bi-cart-check"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Posts Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-fire"></i> Bài Viết Mới Nhất
        </h5>
        <a asp-controller="Post" asp-action="Index" class="btn btn-sm btn-outline-primary">
            Xem tất cả
        </a>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Count() > 0)
        {
            <div class="row g-3">
                @foreach (var post in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border shadow-sm" style="transition: all 0.3s; cursor: pointer;" 
                             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)'" 
                             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 2px rgba(0,0,0,0.05)'">

                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl" class="card-img-top" alt="@post.Title" style="height: 180px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top" style="height: 180px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    <span class="text-white text-center">
                                        <i class="bi bi-image" style="font-size: 2.5rem;"></i>
                                    </span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">
                                @if (post.Category != null)
                                {
                                    <span class="badge bg-primary mb-2" style="width: fit-content; font-size: 0.75rem;">@post.Category.Name</span>
                                }

                                <h6 class="card-title">@post.Title</h6>

                                <p class="card-text text-muted flex-grow-1" style="font-size: 0.875rem;">
                                    @if (!string.IsNullOrEmpty(post.Content))
                                    {
                                        @Html.Raw(post.Content.Length > 80 ? post.Content.Substring(0, 80) + "..." : post.Content)
                                    }
                                </p>

                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                    <small class="text-secondary">
                                        <i class="bi bi-calendar-event"></i>
                                        @post.CreatedDate.ToString("dd/MM/yyyy")
                                    </small>
                                    <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-primary">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center mb-0" role="alert">
                <i class="bi bi-info-circle"></i> Không có bài viết nào
            </div>
        }
    </div>
</div>

<!-- Recent Activity Section -->
<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history"></i> Hoạt Động Gần Đây
                </h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    <div class="timeline-item d-flex gap-3 mb-3">
                        <div style="width: 40px; height: 40px; background: #4f46e5; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0;">
                            <i class="bi bi-file-earmark-plus"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-500">Thêm bài viết mới</p>
                            <small class="text-muted">2 giờ trước</small>
                        </div>
                    </div>
                    <div class="timeline-item d-flex gap-3 mb-3">
                        <div style="width: 40px; height: 40px; background: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0;">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-500">Thêm người dùng mới</p>
                            <small class="text-muted">5 giờ trước</small>
                        </div>
                    </div>
                    <div class="timeline-item d-flex gap-3">
                        <div style="width: 40px; height: 40px; background: #f59e0b; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0;">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-500">Chỉnh sửa danh mục</p>
                            <small class="text-muted">1 ngày trước</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0">
                    <i class="bi bi-graph-up"></i> Thống Kê
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small fw-500">Bài viết</span>
                        <span class="small text-muted">75%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" style="width: 75%"></div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small fw-500">Người dùng</span>
                        <span class="small text-muted">60%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 60%"></div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small fw-500">Sản phẩm</span>
                        <span class="small text-muted">45%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: 45%"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small fw-500">Đơn hàng</span>
                        <span class="small text-muted">90%</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-danger" style="width: 90%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
