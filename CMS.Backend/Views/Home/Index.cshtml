@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container my-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4">Chào mừng - Nguyen Dinh Lam</h1>
            <p class="lead text-muted">Hệ thống quản lý nội dung CMS</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="bi bi-fire"></i> 3 Bài Viết Mới Nhất
            </h2>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Count() > 0)
        {
            @foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm hover-shadow" style="transition: transform 0.3s; cursor: pointer;" 
                         onmouseover="this.style.transform='translateY(-5px)'" 
                         onmouseout="this.style.transform='translateY(0)'">

                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                        {
                            <img src="@post.ImageUrl" class="card-img-top" alt="@post.Title" style="height: 250px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-gradient" style="height: 250px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                <span class="text-white text-center">
                                    <i class="bi bi-image" style="font-size: 3rem;"></i><br>
                                    Không có hình ảnh
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            @if (post.Category != null)
                            {
                                <span class="badge bg-primary mb-2" style="width: fit-content;">@post.Category.Name</span>
                            }

                            <h5 class="card-title">@post.Title</h5>

                            <p class="card-text text-muted flex-grow-1">
                                @if (!string.IsNullOrEmpty(post.Content))
                                {
                                    @Html.Raw(post.Content.Length > 100 ? post.Content.Substring(0, 100) + "..." : post.Content)
                                }
                                else
                                {
                                    <span class="text-secondary">Không có nội dung</span>
                                }
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <small class="text-secondary">
                                    <i class="bi bi-calendar-event"></i>
                                    @post.CreatedDate.ToString("dd/MM/yyyy")
                                </small>
                                <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-primary">
                                    Xem chi tiết <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center" role="alert">
                    <h4 class="alert-heading">
                        <i class="bi bi-info-circle"></i> Không có bài viết
                    </h4>
                    <p>Hiện tại chưa có bài viết nào trong hệ thống. Vui lòng quay lại sau!</p>
                </div>
            </div>
        }
    </div>

    <div class="row mt-5">
        <div class="col-12 text-center">
            <a asp-controller="Post" asp-action="Index" class="btn btn-lg btn-outline-primary">
                <i class="bi bi-list-ul"></i> Xem tất cả bài viết
            </a>
        </div>
    </div>
</div>
