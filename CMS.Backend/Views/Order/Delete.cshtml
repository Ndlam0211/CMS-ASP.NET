@using CMS.Data.Entities

@{
    ViewData["Title"] = "Xóa đơn hàng";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Xác nhận xóa</h4>
                <p>Bạn chắc chắn muốn xóa đơn hàng này không? Hành động này không thể hoàn tác.</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Đơn hàng #@Model?.Id</h5>
                    <p class="card-text">
                        <strong>Khách hàng:</strong> @Model?.Customer?.FullName<br />
                        <strong>Trạng thái:</strong>
                        @if (Model?.Status == 0)
                        {
                            <span class="badge bg-warning">Chờ duyệt</span>
                        }
                        else if (Model?.Status == 1)
                        {
                            <span class="badge bg-info">Đang giao</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Đã hoàn thành</span>
                        }
                    </p>

                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@Model?.Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
