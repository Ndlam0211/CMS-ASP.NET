@using CMS.Data.Entities

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title display-6">Chi tiết đơn hàng #@Model?.Id</h1>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="mb-2">
                                <strong>Khách hàng:</strong> @Model?.Customer?.FullName
                            </p>
                            <p class="mb-2">
                                <strong>Email:</strong> <a href="mailto:@Model?.Customer?.Email">@Model?.Customer?.Email</a>
                            </p>
                            <p class="mb-0">
                                <strong>Điện thoại:</strong> <a href="tel:@Model?.Customer?.Phone">@Model?.Customer?.Phone</a>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2">
                                <strong>Trạng thái:</strong>
                                @if (Model?.Status == 0)
                                {
                                    <span class="badge bg-warning">Chờ duyệt</span>
                                }
                                else if (Model?.Status == 1)
                                {
                                    <span class="badge bg-info">Đang giao</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Đã hoàn thành</span>
                                }
                            </p>
                            <p class="mb-0">
                                <strong>Ghi chú:</strong> @Model?.Notes
                            </p>
                        </div>
                    </div>

                    <div class="border-top pt-4 mt-4">
                        <h5 class="mb-3">Chi tiết sản phẩm</h5>
                        @if (Model?.OrderDetails != null && Model.OrderDetails.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Số lượng</th>
                                            <th>Giá</th>
                                            <th>Tổng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            decimal total = 0;
                                        }
                                        @foreach (var item in Model.OrderDetails)
                                        {
                                            <tr>
                                                <td>@item.Product?.Name</td>
                                                <td>@item.Quantity</td>
                                                <td>@item.UnitPrice.ToString("N0") ?</td>
                                                <td>
                                                    @{
                                                        decimal itemTotal = item.UnitPrice * item.Quantity;
                                                        total += itemTotal;
                                                    }
                                                    @itemTotal.ToString("N0") ?
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="3" class="text-end">
                                                <strong>Tổng cộng:</strong>
                                            </td>
                                            <td>
                                                <strong>@total.ToString("N0") ?</strong>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Không có sản phẩm trong đơn hàng này.</p>
                        }
                    </div>

                    <div class="d-flex gap-2 border-top pt-4 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
