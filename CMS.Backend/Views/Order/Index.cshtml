@using CMS.Data.Entities

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-4">Quản lý đơn hàng</h1>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Thêm đơn hàng
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Khách hàng</th>
                                <th>Số sản phẩm</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>#@order.Id</td>
                                    <td>
                                        <strong>@order.Customer?.FullName</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(order.OrderDetails?.Count ?? 0)</span>
                                    </td>
                                    <td>
                                        @if (order.Status == 0)
                                        {
                                            <span class="badge bg-warning">Chờ duyệt</span>
                                        }
                                        else if (order.Status == 1)
                                        {
                                            <span class="badge bg-info">Đang giao</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đã hoàn thành</span>
                                        }
                                    </td>
                                    <td>@order.Notes</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <p class="text-muted">
                            Tổng cộng: <strong>@Model.Count</strong> đơn hàng
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">Kh�ng c� d? li?u</h4>
                    <p>Hiện tại không có đơn hàng nào trong hệ thống.</p>
                </div>
            }
        </div>
    </div>
</div>
