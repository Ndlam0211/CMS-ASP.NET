@model CMS.Data.Entities.Post
@using CMS.Data.Entities

@{
    ViewData["Title"] = "Thêm bài vi?t m?i";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay l?i danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title display-6">Thêm bài vi?t m?i</h1>

                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Tiêu ?? <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Nh?p tiêu ?? bài vi?t" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">Danh m?c <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-control">
                                <option value="">-- Ch?n danh m?c --</option>
                                @foreach (var category in ViewData["Categories"] as List<Category> ?? new List<Category>())
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label">N?i dung <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" class="form-control" rows="6" placeholder="Nh?p n?i dung bài vi?t"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label">URL Hình ?nh</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> L?u
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> H?y
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
