@using CMS.Data.Entities

@{
    ViewData["Title"] = Model?.Title ?? "Chi tiết bài viết";
}

<!-- Page Header -->
<div class="mb-4">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<!-- Details Container -->
<div style="max-width: 900px;">
    <article class="card border-0 shadow-sm">
        <!-- Featured Image -->
        @if (!string.IsNullOrEmpty(Model?.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="height: 400px; object-fit: cover;">
        }
        else
        {
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 400px;">
                <span class="text-white">Không có hình ảnh</span>
            </div>
        }

        <!-- Article Content -->
        <div class="card-body">
            <!-- Title -->
            <h1 class="mb-3">@Model?.Title</h1>

            <!-- Meta Information -->
            <div class="border-bottom pb-3 mb-4">
                <p class="text-muted mb-2">
                    <i class="bi bi-calendar-event"></i>
                    Ngày đăng: <strong>@Model?.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong>
                </p>
                @if (Model?.Category != null)
                {
                    <p class="text-muted mb-0">
                        <i class="bi bi-folder"></i>
                        Danh mục: <span class="badge bg-info">@Model.Category.Name</span>
                    </p>
                }
            </div>

            <!-- Article Content -->
            <div class="mb-5">
                @if (!string.IsNullOrEmpty(Model?.Content))
                {
                    <p>@Html.Raw(Model.Content)</p>
                }
                else
                {
                    <p class="text-muted">Nội dung bài viết không có sẵn.</p>
                }
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 border-top pt-4">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Xóa
                </a>
            </div>
        </div>
    </article>
</div>
