
@using CMS.Data.Entities

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-4">Danh sách bài viết</h1>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Thêm bài viết
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var post in Model ?? new List<Post>())
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl" class="card-img-top" alt="@post.Title" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                            <span class="text-white">Không có hình ảnh</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-info text-dark fw-semibold rounded-pill">
                            @post.Category.Name
                        </span>
                        <h5 class="card-title">@post.Title</h5>
                        <p class="card-text text-muted flex-grow-1">
                            @if (!string.IsNullOrEmpty(post.Content))
                            {
                                @Html.Raw(post.Content.Length > 100 ? post.Content.Substring(0, 100) + "..." : post.Content)
                            }
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-secondary">
                                @post.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </small>
                            <a asp-action="Details" asp-route-id="@post.Id"x` class="btn btn-sm btn-primary">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info mt-4" role="alert">
            <h4 class="alert-heading">Không có bài viết</h4>
            <p>Hiện tại chưa có bài viết nào trong hệ thống.</p>
        </div>
    }
</div>
