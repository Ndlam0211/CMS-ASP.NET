@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Quản lý bài viết";
}

<!-- Page Header -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-file-earmark-text"></i> Quản lý bài viết
            </h1>
            <p class="text-muted mb-0">Quản lý tất cả bài viết trên hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm bài viết
        </a>
    </div>
</div>

<!-- Content Card -->
<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model != null && Model.Count() > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 30%;">Tiêu đề</th>
                            <th style="width: 15%;">Danh mục</th>
                            <th style="width: 20%;">Ngày đăng</th>
                            <th style="width: 15%;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">@post.Id</span>
                                </td>
                                <td>
                                    <strong>@post.Title</strong>
                                </td>
                                <td>
                                    @if (post.Category != null)
                                    {
                                        <span class="badge bg-info">@post.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không xác định</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@post.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@post.Id" class="btn btn-outline-info" title="Xem chi ti?t">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@post.Id" class="btn btn-outline-warning" title="Ch?nh s?a">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@post.Id" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0" role="alert">
                <i class="bi bi-info-circle"></i> Không có bài viết nào trong hệ thống
            </div>
        }
    </div>
</div>
