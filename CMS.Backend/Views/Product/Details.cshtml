@using CMS.Data.Entities

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 300px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-secondary" style="height: 300px; display: flex; align-items: center; justify-content: center;">
                        <span class="text-white">Không có hình ảnh</span>
                    </div>
                }

                <div class="card-body">
                    <h1 class="card-title display-6">@Model?.Name</h1>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="mb-2">
                                <strong>Danh mục:</strong>
                                @if (Model?.CategoryProduct != null)
                                {
                                    <span class="badge bg-info">@Model.CategoryProduct.Name</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2">
                                <strong>Giá:</strong>
                                <span class="text-success fs-5">@Model?.Price.ToString("N0") đ</span>
                            </p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="mb-2">
                                <strong>Tồn kho:</strong>
                                @if (Model?.StockQuantity > 0)
                                {
                                    <span class="badge bg-success">@Model.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="border-top border-bottom py-3 mb-4">
                        <h5>Mô tả sản phẩm</h5>
                        <p>@Model?.Description</p>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
