@model CMS.Backend.Models.PaginatedList<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<!-- Page Header -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-box"></i> Quản lý sản phẩm
            </h1>
            <p class="text-muted mb-0">Quản lý sản phẩm của cửa hàng</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm
        </a>
    </div>
</div>

<!-- Content Card -->
<div class="card border-0 shadow-sm">
    <!-- Filter Section -->
    <div class="card-header bg-white border-bottom">
        <div class="row g-3 align-items-end">
            <!-- Page Size -->
            <div class="col-md-2">
                <label class="form-label small text-muted">Hiển thị</label>
                <select class="form-select form-select-sm" onchange="changePageSize(this.value)">
                    @{
                        int currentSize = (int)ViewBag.PageSize;
                        int[] pageSizes = { 5, 10, 20, 50, 100 };
                    }
                    @foreach (var size in pageSizes)
                    {
                        if (currentSize == size)
                        {
                            <option value="@size" selected>@size phần tử</option>
                        }
                        else
                        {
                            <option value="@size">@size phần tử</option>
                        }
                    }
                </select>
            </div>

            <!-- Category Filter -->
            <div class="col-md-3">
                <label class="form-label small text-muted">Danh mục</label>
                <select class="form-select form-select-sm" onchange="filterByCategory(this.value)">
                    @{
                        var categories = (List<CMS.Data.Entities.CategoryProduct>)ViewBag.CategoryProducts;
                        var selectedCategoryId = (int?)ViewBag.SelectedCategoryId;
                    }
                    @if (selectedCategoryId == null || selectedCategoryId == 0)
                    {
                        <option value="" selected>Tất cả danh mục</option>
                    }
                    else
                    {
                        <option value="">Tất cả danh mục</option>
                    }
                    @if (categories != null)
                    {
                        @foreach (var category in categories)
                        {
                            @if (selectedCategoryId == category.Id)
                            {
                                <option value="@category.Id" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    }
                </select>
            </div>

            <!-- Price Sort -->
            <div class="col-md-3">
                <label class="form-label small text-muted">Sắp xếp giá</label>
                <select class="form-select form-select-sm" onchange="sortByPrice(this.value)">
                    @{
                        var selectedSort = (string)ViewBag.SelectedSortPrice;
                    }
                    @if (string.IsNullOrEmpty(selectedSort))
                    {
                        <option value="" selected>Mặc định</option>
                    }
                    else
                    {
                        <option value="">Mặc định</option>
                    }
                    @if (selectedSort == "asc")
                    {
                        <option value="asc" selected>Giá tăng dần</option>
                    }
                    else
                    {
                        <option value="asc">Giá tăng dần</option>
                    }
                    @if (selectedSort == "desc")
                    {
                        <option value="desc" selected>Giá giảm dần</option>
                    }
                    else
                    {
                        <option value="desc">Giá giảm dần</option>
                    }
                </select>
            </div>

            <!-- Reset Button -->
            <div class="col-md-2">
                <button class="btn btn-outline-secondary btn-sm w-100" onclick="resetFilters()">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>

            <!-- Info -->
            <div class="col-md-2">
                <span class="text-muted small">
                    Showing <strong>@Model.StartIndex</strong> to <strong>@Model.EndIndex</strong> of <strong>@Model.TotalItems</strong> products
                </span>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="card-body">
        @if (Model != null && Model.Items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 25%;">Tên sản phẩm</th>
                            <th style="width: 15%;">Danh mục</th>
                            <th style="width: 10%;">Hình ảnh</th>
                            <th style="width: 12%;">Giá</th>
                            <th style="width: 10%;">Tồn kho</th>
                            <th style="width: 13%;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">@product.Id</span>
                                </td>
                                <td>
                                    <strong>@product.Name</strong>
                                </td>
                                <td>
                                    @if (product.CategoryProduct != null)
                                    {
                                        <span class="badge bg-info">@product.CategoryProduct.Name</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" style="width:50px; height:50px; object-fit:cover; border-radius:6px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không có</span>
                                    }
                                </td>
                                <td>
                                    <strong>@product.Price.ToString("N0")đ</strong>
                                </td>
                                <td>
                                    @if (product.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success">@product.StockQuantity</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-info" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <nav class="mt-4" aria-label="Table pagination">
                <ul class="pagination justify-content-center mb-0">
                    <!-- Previous Button -->
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@ViewBag.PageSize" asp-route-categoryProductId="@ViewBag.SelectedCategoryId" asp-route-sortPrice="@ViewBag.SelectedSortPrice">
                                <i class="bi bi-chevron-left"></i> Trước
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <i class="bi bi-chevron-left"></i> Trước
                            </span>
                        </li>
                    }

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-pageSize="@ViewBag.PageSize" asp-route-categoryProductId="@ViewBag.SelectedCategoryId" asp-route-sortPrice="@ViewBag.SelectedSortPrice">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        @if (i == Model.CurrentPage)
                        {
                            <li class="page-item active">
                                <span class="page-link">
                                    @i
                                    <span class="visually-hidden">(current)</span>
                                </span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@ViewBag.PageSize" asp-route-categoryProductId="@ViewBag.SelectedCategoryId" asp-route-sortPrice="@ViewBag.SelectedSortPrice">@i</a>
                            </li>
                        }
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-pageSize="@ViewBag.PageSize" asp-route-categoryProductId="@ViewBag.SelectedCategoryId" asp-route-sortPrice="@ViewBag.SelectedSortPrice">@Model.TotalPages</a>
                        </li>
                    }

                    <!-- Next Button -->
                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@ViewBag.PageSize" asp-route-categoryProductId="@ViewBag.SelectedCategoryId" asp-route-sortPrice="@ViewBag.SelectedSortPrice">
                                Sau <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                Sau <i class="bi bi-chevron-right"></i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>
        }
        else
        {
            <div class="alert alert-info mb-0" role="alert">
                <i class="bi bi-info-circle"></i> Không có sản phẩm nào trong hệ thống
            </div>
        }
    </div>
</div>

<!-- JavaScript Functions -->
<script>
    function changePageSize(pageSize) {
        const categoryId = new URLSearchParams(window.location.search).get('categoryProductId') || '';
        const sortPrice = new URLSearchParams(window.location.search).get('sortPrice') || '';
        let url = '@Url.Action("Index")' + '?page=1&pageSize=' + pageSize;
        if (categoryId) url += '&categoryProductId=' + categoryId;
        if (sortPrice) url += '&sortPrice=' + sortPrice;
        window.location.href = url;
    }

    function filterByCategory(categoryId) {
        const pageSize = new URLSearchParams(window.location.search).get('pageSize') || '10';
        const sortPrice = new URLSearchParams(window.location.search).get('sortPrice') || '';
        let url = '@Url.Action("Index")' + '?page=1&pageSize=' + pageSize;
        if (categoryId) url += '&categoryProductId=' + categoryId;
        if (sortPrice) url += '&sortPrice=' + sortPrice;
        window.location.href = url;
    }

    function sortByPrice(sortPrice) {
        const pageSize = new URLSearchParams(window.location.search).get('pageSize') || '10';
        const categoryId = new URLSearchParams(window.location.search).get('categoryProductId') || '';
        let url = '@Url.Action("Index")' + '?page=1&pageSize=' + pageSize;
        if (categoryId) url += '&categoryProductId=' + categoryId;
        if (sortPrice) url += '&sortPrice=' + sortPrice;
        window.location.href = url;
    }

    function resetFilters() {
        window.location.href = '@Url.Action("Index")' + '?page=1&pageSize=10';
    }
</script>
