@using CMS.Data.Entities

@{
    ViewData["Title"] = "Chi tiết người dùng";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title display-6">@Model?.FullName</h1>

                    <div class="border-bottom pb-3 mb-4">
                        <p class="mb-2">
                            <strong>Tên đăng nhập:</strong> @Model?.Username
                        </p>
                        <p class="mb-0">
                            <strong>Vai trò:</strong> 
                            @if (Model?.Role == "Admin")
                            {
                                <span class="badge bg-danger">Quản trị viên</span>
                            }
                            else if (Model?.Role == "Editor")
                            {
                                <span class="badge bg-info">Biên tập viên</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model?.Role</span>
                            }
                        </p>
                    </div>

                    <div class="d-flex gap-2 border-top pt-4 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
