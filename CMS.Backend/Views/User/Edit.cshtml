@model CMS.Data.Entities.User
@using CMS.Data.Entities

@{
    ViewData["Title"] = "Ch?nh s?a ng??i dùng";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay l?i danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title display-6">Ch?nh s?a ng??i dùng</h1>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">H? và tên <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Tài kho?n <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PasswordHash" class="form-label">M?t kh?u <span class="text-danger">*</span></label>
                            <input asp-for="PasswordHash" type="password" class="form-control" />
                            <span asp-validation-for="PasswordHash" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Vai trò <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-control">
                                <option value="">-- Ch?n vai trò --</option>
                                <option value="Admin" selected="@(Model?.Role == "Admin")">Qu?n tr? viên</option>
                                <option value="Editor" selected="@(Model?.Role == "Editor")">Biên t?p viên</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> C?p nh?t
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> H?y
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
