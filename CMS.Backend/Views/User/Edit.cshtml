@model CMS.Data.Entities.User
@using CMS.Data.Entities

@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title display-6">Chỉnh sửa người dùng</h1>

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control" readonly/>
                            <span class="text-muted">Tên đăng nhập không được phép thay đổi</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control" name="password" placeholder="Để trống nếu không muốn đổi" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Vai trò <span class="text-danger">*</span></label>
                            <select asp-for="Role" class="form-control">
                                <option value="">-- Chọn vai trò --</option>
                                <option value="Admin" selected="@(Model?.Role == "Admin")">Admin</option>
                                <option value="Editor" selected="@(Model?.Role == "Editor")">Editor</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Cập nhật
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
