@model CMS.Backend.Models.PaginatedList<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<!-- Page Header -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-person-gear"></i> Quản lý người dùng
            </h1>
            <p class="text-muted mb-0">Quản lý tất cả người dùng trên hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Thêm người dùng
        </a>
    </div>
</div>

<!-- Content Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <div>
            <span class="text-muted small">
                Showing <strong>@Model.StartIndex</strong> to <strong>@Model.EndIndex</strong> of <strong>@Model.TotalItems</strong> users
            </span>
        </div>
        <div>
            <label class="me-2" style="display: inline-block;">Hiển thị:</label>
            <select class="form-select" style="width: auto; display: inline-block;" onchange="changePageSize(this.value)">
                @{
                    int currentSize = (int)ViewBag.PageSize;
                    int[] pageSizes = { 5, 10, 20, 50, 100 };
                }
                @foreach (var size in pageSizes)
                {
                    if (currentSize == size)
                    {
                        <option value="@size" selected>@size</option>
                    }
                    else
                    {
                        <option value="@size">@size</option>
                    }
                }
            </select>
            <span class="ms-2 text-muted small">users</span>
        </div>
    </div>

    <div class="card-body">
        @if (Model != null && Model.Items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm">
                    <thead>
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 20%;">Tên đăng nhập</th>
                            <th style="width: 25%;">Họ và tên</th>
                            <th style="width: 20%;">Vai trò</th>
                            <th style="width: 15%;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Items)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-secondary">@user.Id</span>
                                </td>
                                <td>
                                    <strong>@user.Username</strong>
                                </td>
                                <td>@user.FullName</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">@user.Role</span>
                                    }
                                    else if (user.Role == "Editor")
                                    {
                                        <span class="badge bg-warning">@user.Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@user.Role</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-info" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            <nav class="mt-4" aria-label="Table pagination">
                <ul class="pagination justify-content-center mb-0">
                    <!-- Previous Button -->
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-pageSize="@ViewBag.PageSize">
                                <i class="bi bi-chevron-left"></i> Trước
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <i class="bi bi-chevron-left"></i> Trước
                            </span>
                        </li>
                    }

                    <!-- Page Numbers -->
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-pageSize="@ViewBag.PageSize">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        @if (i == Model.CurrentPage)
                        {
                            <li class="page-item active">
                                <span class="page-link">
                                    @i
                                    <span class="visually-hidden">(current)</span>
                                </span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@ViewBag.PageSize">@i</a>
                            </li>
                        }
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-pageSize="@ViewBag.PageSize">@Model.TotalPages</a>
                        </li>
                    }

                    <!-- Next Button -->
                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-pageSize="@ViewBag.PageSize">
                                Sau <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                Sau <i class="bi bi-chevron-right"></i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>
        }
        else
        {
            <div class="alert alert-info mb-0" role="alert">
                <i class="bi bi-info-circle"></i> Không có người dùng nào trong hệ thống
            </div>
        }
    </div>
</div>

<script>
    function changePageSize(pageSize) {
        window.location.href = '@Url.Action("Index")' + '?page=1&pageSize=' + pageSize;
    }
</script>
