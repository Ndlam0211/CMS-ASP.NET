@using CMS.Data.Entities

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-4">Quản lý người dùng</h1>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Thêm người dùng
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Username</th>
                                <th>Họ và tên</th>
                                <th>Role</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Id</td>
                                    <td>
                                        <strong>@user.Username</strong>
                                    </td>
                                    <td>@user.FullName</td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">@user.Role</span>
                                        }
                                        else if (user.Role == "Editor")
                                        {
                                            <span class="badge bg-info">@user.Role</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@user.Role</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <p class="text-muted">
                            Tổng cộng: <strong>@Model.Count</strong> người dùng
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-heading">Không có dữ liệu</h4>
                    <p>Hiện tại không có người dùng nào trong hệ thống.</p>
                </div>
            }
        </div>
    </div>
</div>
